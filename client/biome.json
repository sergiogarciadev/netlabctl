{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "include": ["src/**/*"],
    "ignore": ["**/dist/**", "**/node_modules/**"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useSemanticElements": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
